// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  name          String?
  role          UserRole      @default(BUYER)
  phone         String?
  address       String?
  listings      EnergyListing[]
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model EnergyListing {
  id              String        @id @default(cuid())
  sellerId        String
  seller          User          @relation(fields: [sellerId], references: [id])
  
  // Basic Information
  title           String        // e.g., "Solar Energy from Chennai Plant"
  description     String?       // Detailed description of the energy source
  energyType      EnergyType    // SOLAR, WIND, HYDRO, etc.
  
  // Location Details
  location        String        // City/Area
  state           String
  pincode         String
  address         String        // Full address
  
  // Energy Details
  totalCapacity   Float         // Total capacity in kWh
  availableUnits  Float         // Currently available units
  minPurchase     Float         // Minimum units that can be purchased
  maxPurchase     Float         // Maximum units that can be purchased
  
  // Pricing
  pricePerUnit    Float         // Price per kWh in BIJLEE tokens
  discount        Float?        // Optional discount percentage
  
  // Additional Details
  deliveryMethod  DeliveryMethod // GRID, DIRECT, etc.
  sourceType      SourceType     // RESIDENTIAL, COMMERCIAL, INDUSTRIAL
  certification   String?        // Any energy certifications
  
  // Status
  status          ListingStatus @default(ACTIVE)
  visibility      Boolean       @default(true)  // Can hide/show listing
  featured        Boolean       @default(false) // For premium listings
  
  // Relations
  transactions    Transaction[]
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  validUntil      DateTime?     // Optional expiry date for the listing
}

model Transaction {
  id            String        @id @default(cuid())
  listingId     String
  listing       EnergyListing @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User          @relation(fields: [buyerId], references: [id])
  units         Float
  pricePerUnit  Float
  totalPrice    Float
  status        TransactionStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum UserRole {
  BUYER
  SELLER
}

enum EnergyType {
  SOLAR
  WIND
  HYDRO
  BIOMASS
  GEOTHERMAL
}

enum DeliveryMethod {
  GRID
  DIRECT
  HYBRID
}

enum SourceType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  UTILITY
}

enum ListingStatus {
  ACTIVE
  PENDING
  SOLD_OUT
  CANCELLED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}